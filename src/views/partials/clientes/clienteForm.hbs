<div class="card card-body bg-dark text-white border-secondary rounded-3">
    <h3 class="fw-bold mb-4">Agregar el Cliente</h3>

    <form action="/clientes/agregar" method="POST">
        
        <div class="mb-3">
            <label for="nombre" class="form-label">Escribe nombre:</label>
            <input type="text" name="nombre" placeholder="Name" class="form-control bg-dark text-white border-secondary" required>
        </div>

        <div class="mb-3">
            <label for="apellido" class="form-label">Escribe apellido:</label>
            <input type="text" name="apellido" placeholder="Apellido" class="form-control bg-dark text-white border-secondary" required>
        </div>

        <div class="mb-3">
            <label for="edad" class="form-label">Escribe edad:</label>
            <input type="number" name="edad" placeholder="Edad" class="form-control bg-dark text-white border-secondary" required>
        </div>

        <div class="mb-3">
            <label for="correo" class="form-label">Escribe correo:</label>
            <input type="email" name="correo" placeholder="Email" class="form-control bg-dark text-white border-secondary" required>
        </div>

        <div class="mb-3">
            <label for="telefono" class="form-label">Escribe teléfono:</label>
            <input type="text" name="telefono" placeholder="Phone" class="form-control bg-dark text-white border-secondary" required>
        </div>

        <button type="submit" class="btn btn-success btn-sm px-3">Agregar</button>

    </form>
</div>